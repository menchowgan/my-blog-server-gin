# Database Configuration
DATABASE_DRIVER=mysql
DATABASE_ADDR=127.0.0.1:3306
DATABASE_USER=root
DATABASE_PASS=your_database_password_here
DATABASE_NAME=gmc_blog

# Redis Configuration
REDIS_ADDR=127.0.0.1:6379

# File Storage Paths
PHOTO_PATH=/usr/local/share/images/
MUSIC_PATH=/usr/local/share/music/
VIDEO_PATH=/usr/local/share/video/
CHUNK_PATH=/usr/local/share/chunks/
FILE_PATH=/usr/local/share/files/

# Public Asset URLs (if needed)
PHOTO_QUERY_PATH=http://localhost/
MUSIC_QUERY_PATH=http://localhost/
VIDEO_QUERY_PATH=http://localhost/
